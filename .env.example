# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable / anon key: safe for the browser, every request is still checked by RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role / secret key: SERVER ONLY. Used only to create accounts and reset passwords.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the app (used in links, e.g. https://bogcha.example.uz)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Login uses usernames; internally they map to <username>@AUTH_EMAIL_DOMAIN.
# Change only before the first accounts are created.
AUTH_EMAIL_DOMAIN=users.bogcha.app

# --- Optional integrations (leave empty to keep them disabled) ---
# Telegram bot token from @BotFather. Parents need a telegram_chat_id on their guardian record.
TELEGRAM_BOT_TOKEN=
# SMS via Eskiz.uz (https://eskiz.uz). Leave empty to disable SMS.
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
# Shared secret that a biometric/face-ID terminal sends in the "Authorization: Bearer" header.
BIOMETRIC_DEVICE_TOKEN=
# Secret for the scheduled dispatcher endpoint (/api/integrations/dispatch). Vercel Cron sends it automatically.
CRON_SECRET=
